# Copia este archivo a .env.local y pon tus llaves.

# La usa el proxy /api/anthropic (Vite en local; api/anthropic/v1/messages.ts en Vercel).
# Nunca llega al navegador. En Vercel: Settings → Environment Variables → Redeploy.
ANTHROPIC_API_KEY=

# Supabase: Storage (PDFs/archivos DG) + sesión compartida (tabla app_state).
# Sin estas dos la app sigue en solo-localStorage. Están en Project Settings → API.
# La llave anon es pública por diseño. NUNCA pongas la service_role aquí.
# Tras configurar, corre supabase/schema.sql una vez en el SQL Editor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
