# Copia este archivo a .env.local y pon tus llaves.

# La usa el proxy /api/anthropic de vite.config.ts; nunca llega al navegador.
ANTHROPIC_API_KEY=

# Supabase Storage: donde se guardan los archivos que entregan los DGs
# (pantalla 03). Sin estas dos la app funciona igual, pero solo registra el
# nombre del archivo, sin guardarlo. Están en el panel de Supabase, en
# Project Settings → API. La llave anon es pública por diseño: va en el
# navegador y lo que protege el bucket son las políticas de supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
